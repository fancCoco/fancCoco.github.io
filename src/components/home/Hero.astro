---
import { siteConfig } from '../../config';
import { sitePath } from '../../lib/urls';
---
<section id="bio" class="profile section-space">
  <div class="shell profile__grid">
    <div class="profile__copy">
      <p class="eyebrow">Northbridge Institute</p>
      <h1 class="display-title">{siteConfig.name}</h1>
      <p class="profile__role">Researcher in Intelligent Systems</p>
      <p class="profile__links">
        <a href="mailto:fan.chen@example.edu">fan.chen@example.edu</a>
        <span aria-hidden="true">·</span>
        <a href={sitePath('/#publications')}>CV</a>
        <span aria-hidden="true">·</span>
        <a href={sitePath('/#publications')}>Scholar</a>
        <span aria-hidden="true">·</span>
        <a href={sitePath('/#contact')}>GitHub</a>
      </p>
      <div class="profile__bio">
        <p>Fan Chen studies learning, planning, and collaboration for autonomous systems that operate in changing environments.</p>
        <p>Current work explores how agents can make useful decisions under uncertainty, recover from failure, and communicate their limits.</p>
      </div>
    </div>
    <div class="profile__portrait" role="img" aria-label="FC profile placeholder">
      <span>FC</span>
    </div>
  </div>
</section>

<style>
  .profile { padding-top: clamp(4.5rem, 9vw, 7rem); }
  .profile__grid { display: grid; grid-template-columns: minmax(0, 1fr) 230px; align-items: start; gap: clamp(3rem, 10vw, 8rem); }
  .profile__copy { max-width: 680px; }
  .profile__role { margin: 1.35rem 0 0; color: var(--color-primary); font-size: 1.08rem; font-weight: 650; }
  .profile__links { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.8rem 0 0; color: var(--color-muted); font-size: 0.9rem; }
  .profile__links a { color: var(--color-primary); text-underline-offset: 0.22em; }
  .profile__bio { max-width: 62ch; margin-top: 2.1rem; color: var(--color-muted); font-size: 1.02rem; }
  .profile__bio p { margin: 0 0 1rem; }
  .profile__portrait { display: grid; place-items: center; aspect-ratio: 4 / 5; border: 1px solid var(--color-border); border-top: 5px solid var(--color-accent); background: linear-gradient(145deg, var(--color-surface-raised), var(--color-surface)); color: var(--color-primary); }
  .profile__portrait span { font-size: clamp(3.7rem, 8vw, 5.5rem); font-weight: 760; letter-spacing: -0.12em; line-height: 1; transform: translateX(-0.08em); }
  @media (max-width: 700px) {
    .profile__grid { grid-template-columns: 1fr; gap: 2.4rem; }
    .profile__portrait { width: 150px; }
  }
</style>
