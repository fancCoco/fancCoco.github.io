---
const areas = [
  {
    number: '01',
    title: 'Adaptive Planning',
    summary: 'Planning systems that recover gracefully when tasks, sensors, or environments change.',
    methods: ['Decision making', 'Recovery', 'Uncertainty'],
  },
  {
    number: '02',
    title: 'Robust Learning',
    summary: 'Learning methods that remain useful beyond the conditions represented in their training data.',
    methods: ['Generalization', 'Evaluation', 'Reliability'],
  },
  {
    number: '03',
    title: 'Human-Agent Collaboration',
    summary: 'Interfaces and reasoning tools that help people supervise complex autonomous systems.',
    methods: ['Interaction', 'Feedback', 'Trust'],
  },
];
---
<div class="research-list">
  {areas.map((area) => (
    <article class="research-item">
      <span class="research-item__number">{area.number}</span>
      <div>
        <h3>{area.title}</h3>
        <p>{area.summary}</p>
        <p class="research-item__methods">{area.methods.join(' · ')}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .research-list { border-top: 1px solid var(--color-border); }
  .research-item { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1.5rem; padding-block: 1.45rem; border-bottom: 1px solid var(--color-border); }
  .research-item__number { color: var(--color-accent); font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.73rem; letter-spacing: 0.08em; }
  .research-item h3 { margin: 0; color: var(--color-primary); font-size: 1.12rem; font-weight: 700; letter-spacing: -0.02em; }
  .research-item p { max-width: 65ch; margin: 0.45rem 0 0; color: var(--color-muted); font-size: 0.94rem; }
  .research-item .research-item__methods { margin-top: 0.7rem; color: var(--color-primary); font-size: 0.76rem; letter-spacing: 0.02em; }
  @media (max-width: 600px) {
    .research-item { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.8rem; }
  }
</style>
