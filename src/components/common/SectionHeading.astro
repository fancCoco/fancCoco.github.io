---
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {description && <p class="lede">{description}</p>}
</div>

<style>
  .section-heading { display: grid; gap: 0.7rem; margin-bottom: 2.5rem; }
  .section-heading .lede { margin: 0; }
</style>
