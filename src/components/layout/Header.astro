---
import { navigation, siteConfig } from '../../config';
import { sitePath } from '../../lib/urls';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="shell site-header__inner">
    <a class="wordmark" href={sitePath('/')} aria-label="Fan Chen home">
      <span class="wordmark__mark">FC</span>
      <span class="wordmark__name">{siteConfig.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => {
        const active = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href.replace(/\/$/, ''));
        return <a href={sitePath(item.href)} aria-current={active ? 'page' : undefined} class={active ? 'is-active' : undefined}>{item.label}</a>;
      })}
    </nav>
    <div class="site-header__tools">
      <ThemeToggle />
      <details class="mobile-nav">
        <summary aria-label="Open navigation menu" title="Open navigation menu">
          <span aria-hidden="true">☰</span>
        </summary>
        <nav aria-label="Mobile navigation">
          {navigation.map((item) => {
            const active = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href.replace(/\/$/, ''));
            return <a href={sitePath(item.href)} aria-current={active ? 'page' : undefined}>{item.label}</a>;
          })}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 62%, transparent);
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(16px);
  }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 4.6rem; gap: 1rem; }
  .wordmark { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--color-primary); }
  .wordmark__mark { display: grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--color-accent); border-radius: 0.55rem; font-family: "JetBrains Mono", monospace; font-size: 0.68rem; font-weight: 800; letter-spacing: -0.08em; }
  .wordmark__name { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.02em; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(0.8rem, 2.1vw, 1.55rem); margin-left: auto; }
  .desktop-nav a { position: relative; color: var(--color-muted); font-size: 0.86rem; text-decoration: none; }
  .desktop-nav a:hover, .desktop-nav a.is-active { color: var(--color-primary); }
  .desktop-nav a.is-active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -0.55rem; height: 2px; background: var(--color-accent); }
  .site-header__tools { display: flex; align-items: center; gap: 0.55rem; }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary { display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border: 1px solid var(--color-border); border-radius: 0.7rem; list-style: none; cursor: pointer; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; right: 0; top: calc(100% + 0.55rem); display: grid; min-width: 10rem; padding: 0.4rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.8rem; box-shadow: 0 16px 30px rgba(var(--color-shadow), 0.16); }
  .mobile-nav nav a { padding: 0.55rem 0.7rem; border-radius: 0.45rem; color: var(--color-text); text-decoration: none; font-size: 0.9rem; }
  .mobile-nav nav a:hover, .mobile-nav nav a[aria-current='page'] { background: var(--color-accent-soft); color: var(--color-primary); }
  @media (max-width: 800px) { .desktop-nav { display: none; } .mobile-nav { display: block; } }
</style>
