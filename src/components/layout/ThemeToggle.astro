<details class="theme-menu">
  <summary aria-label="Change color theme" title="Change color theme">
    <span class="theme-icon theme-icon--sun" aria-hidden="true">☼</span>
    <span class="theme-icon theme-icon--moon" aria-hidden="true">◐</span>
    <span class="sr-only">Theme</span>
  </summary>
  <div class="theme-menu__panel" role="group" aria-label="Theme options">
    <button type="button" data-theme-choice="system">System</button>
    <button type="button" data-theme-choice="light">Light</button>
    <button type="button" data-theme-choice="dark">Dark</button>
  </div>
</details>

<style>
  .theme-menu { position: relative; }
  .theme-menu summary {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
    color: var(--color-text);
    list-style: none;
    cursor: pointer;
  }
  .theme-menu summary::-webkit-details-marker { display: none; }
  .theme-menu summary:hover { border-color: var(--color-border-strong); color: var(--color-primary); }
  .theme-icon--moon { display: none; }
  :global(:root[data-theme='dark']) .theme-icon--sun { display: none; }
  :global(:root[data-theme='dark']) .theme-icon--moon { display: inline; }
  .theme-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    z-index: 20;
    display: grid;
    min-width: 7rem;
    gap: 0.15rem;
    padding: 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    box-shadow: 0 16px 30px rgba(var(--color-shadow), 0.16);
  }
  .theme-menu__panel button {
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    color: var(--color-text);
    padding: 0.45rem 0.6rem;
    text-align: left;
    font-size: 0.82rem;
  }
  .theme-menu__panel button:hover,
  .theme-menu__panel button[aria-pressed='true'] { background: var(--color-accent-soft); color: var(--color-primary); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<script>
  const root = document.documentElement;
  const menu = document.querySelector('.theme-menu');
  const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
  const resolveTheme = (mode: string) => mode === 'system'
    ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
    : mode;
  const setTheme = (mode: string) => {
    root.dataset.theme = resolveTheme(mode);
    root.dataset.themePreference = mode;
    try { localStorage.setItem('theme', mode); } catch {}
    choices.forEach((choice) => choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === mode)));
  };
  let current = 'system';
  try { current = localStorage.getItem('theme') || 'system'; } catch {}
  setTheme(current);
  choices.forEach((choice) => choice.addEventListener('click', () => {
    setTheme(choice.dataset.themeChoice || 'system');
    if (menu instanceof HTMLDetailsElement) menu.open = false;
  }));
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', () => {
    if (root.dataset.themePreference === 'system') setTheme('system');
  });
</script>
