---
import { siteConfig } from '../../config';
import { sitePath } from '../../lib/urls';
---
<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <p class="footer-name">{siteConfig.name}</p>
      <p class="muted">{siteConfig.researchLabel}.</p>
    </div>
    <div class="footer-meta">
      <p>Built as a lightweight academic portfolio.</p>
      <a href={sitePath('/')} aria-label="Return to Fan Chen home">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); padding-block: 2.5rem; }
  .site-footer__grid { display: flex; justify-content: space-between; gap: 2rem; }
  .footer-name { margin: 0; color: var(--color-primary); font-weight: 750; }
  .site-footer p { margin: 0.25rem 0 0; font-size: 0.84rem; }
  .footer-meta { display: flex; align-items: flex-start; gap: 1.4rem; color: var(--color-muted); font-size: 0.84rem; }
  .footer-meta p { margin: 0; }
  .footer-meta a { color: var(--color-primary); text-decoration: none; }
  @media (max-width: 640px) { .site-footer__grid, .footer-meta { display: grid; gap: 0.7rem; } }
</style>
