---
import ContentLayout from '../layouts/ContentLayout.astro';
import ResearchCards from '../components/home/ResearchCards.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
---
<ContentLayout title="Research" description="A space for public research themes and descriptions.">
  <div class="research-intro"><p>Add a short public overview of your research here.</p><p>Keep detailed or unpublished information private until it is ready to share.</p></div>
  <ResearchCards />
  <div class="research-notes"><SectionHeading eyebrow="Research notes" title="Add public notes here." description="Use this space for methods, principles, or other public context." /></div>
</ContentLayout>

<style>
  .research-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 4rem; color: var(--color-muted); }
  .research-intro p { margin: 0; }
  .research-notes { margin-top: 5.5rem; padding-top: 3rem; border-top: 1px solid var(--color-border); }
  @media (max-width: 700px) { .research-intro { grid-template-columns: 1fr; } }
</style>
