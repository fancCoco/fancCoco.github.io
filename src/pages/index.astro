---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ResearchCards from '../components/home/ResearchCards.astro';
import { siteConfig } from '../config';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  url: 'https://fanccoco.github.io',
  image: 'https://fanccoco.github.io/og-default.svg',
};
---
<BaseLayout structuredData={structuredData}>
  <Header />
  <main id="main-content">
    <Hero />

    <section id="news" class="academic-section academic-section--border">
      <div class="shell">
        <h2 class="section-heading">News</h2>
        <div class="news-list">
          <article class="news-row">
            <time datetime="2026-03">Mar 2026</time>
            <p>Measuring Recovery in Adaptive Agents was accepted to ICRA 2026.</p>
          </article>
          <article class="news-row">
            <time datetime="2026-01">Jan 2026</time>
            <p>Joined the Northbridge Robotics Initiative as a visiting researcher.</p>
          </article>
          <article class="news-row">
            <time datetime="2025-10">Oct 2025</time>
            <p>Released AtlasBench, a benchmark for long-horizon planning.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="research" class="academic-section">
      <div class="shell">
        <h2 class="section-heading">Research</h2>
        <p class="section-lede">My research examines how autonomous systems learn, plan, and work with people when the world does not behave exactly as expected.</p>
        <ResearchCards />
      </div>
    </section>

    <section id="publications" class="academic-section academic-section--border">
      <div class="shell">
        <h2 class="section-heading">Selected Publications</h2>
        <div class="publication-list">
          <article class="publication-item">
            <p class="publication-year">2026</p>
            <h3>Measuring Recovery in Adaptive Agents</h3>
            <p class="publication-authors">Fan Chen, Mira Park, and Leo Alvarez</p>
            <p class="publication-venue">International Conference on Robotics and Automation (ICRA), 2026</p>
            <p class="publication-links"><a href="#publications">Paper</a><span aria-hidden="true">·</span><a href="#research">Project</a></p>
            <p class="publication-abstract">A study of how embodied agents detect failure, revise a plan, and return to useful behavior across changing tasks.</p>
          </article>
          <article class="publication-item">
            <p class="publication-year">2025</p>
            <h3>AtlasBench: Evaluating Long-Horizon Robot Planning</h3>
            <p class="publication-authors">Fan Chen, Priya Shah, and Daniel Kim</p>
            <p class="publication-venue">Robotics: Science and Systems (RSS), 2025</p>
            <p class="publication-links"><a href="#publications">Paper</a><span aria-hidden="true">·</span><a href="#research">Code</a></p>
            <p class="publication-abstract">A benchmark for comparing planning systems on tasks that combine uncertain observations, delayed feedback, and evolving goals.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="contact" class="academic-section contact-section">
      <div class="shell">
        <h2 class="section-heading">Contact</h2>
        <p class="contact-copy">For research conversations, collaborations, and seminar invitations, write to <a href="mailto:fan.chen@example.edu">fan.chen@example.edu</a>.</p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .academic-section { padding-block: clamp(3.8rem, 7vw, 5.8rem); }
  .academic-section--border { border-top: 1px solid var(--color-border); }
  .section-heading { margin: 0 0 1.8rem; color: var(--color-primary); font-size: clamp(1.45rem, 2.5vw, 1.8rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.2; }
  .section-lede { max-width: 67ch; margin: -0.35rem 0 2.3rem; color: var(--color-muted); }
  .news-list, .publication-list { border-top: 1px solid var(--color-border); }
  .news-row { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1.5rem; padding-block: 1rem; border-bottom: 1px solid var(--color-border); }
  .news-row time, .publication-year { color: var(--color-muted); font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .news-row p { margin: 0; color: var(--color-text); }
  .publication-item { max-width: 790px; padding-block: 1.8rem 2rem; border-bottom: 1px solid var(--color-border); }
  .publication-item:last-child { border-bottom: 0; }
  .publication-year { margin: 0 0 0.45rem; }
  .publication-item h3 { margin: 0; color: var(--color-primary); font-size: clamp(1.12rem, 2vw, 1.35rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.3; }
  .publication-authors, .publication-venue { margin: 0.45rem 0 0; color: var(--color-muted); font-size: 0.93rem; }
  .publication-venue { font-style: italic; }
  .publication-links { display: flex; gap: 0.55rem; margin: 0.65rem 0 0; font-size: 0.88rem; }
  .publication-links a, .contact-copy a { color: var(--color-primary); font-weight: 650; }
  .publication-abstract { max-width: 70ch; margin: 0.8rem 0 0; color: var(--color-muted); font-size: 0.92rem; }
  .contact-section { border-top: 1px solid var(--color-border); }
  .contact-copy { max-width: 62ch; margin: 0; color: var(--color-muted); }
  @media (max-width: 600px) {
    .news-row { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
