---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ResearchCards from '../components/home/ResearchCards.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import { siteConfig } from '../config';
import { sitePath } from '../lib/urls';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  url: 'https://fanccoco.github.io',
  image: 'https://fanccoco.github.io/og-default.svg',
};
---
<BaseLayout structuredData={structuredData}>
  <Header />
  <main id="main-content">
    <Hero />
    <section class="section-space section-muted">
      <div class="shell narrow-grid">
        <div><p class="eyebrow">About</p><h2 class="section-title">Add a short public introduction.</h2></div>
        <div class="about-copy">
          <p>Use this area for a concise biography or professional overview.</p>
          <p>Only publish information that is ready to be public.</p>
        </div>
      </div>
    </section>
    <section class="section-space">
      <div class="shell"><SectionHeading eyebrow="Research interests" title="Add your research themes." description="Use these cards for public research areas, methods, or topics." /><ResearchCards /></div>
    </section>
    <section class="section-space section-muted">
      <div class="shell"><div class="split-heading"><SectionHeading eyebrow="Selected work" title="Add public publications here." /><a class="text-link" href={sitePath('/publications/')}>View publications ↗</a></div><div class="template-empty">Publication cards will appear here after public entries are added.</div></div>
    </section>
    <section class="section-space">
      <div class="shell"><div class="split-heading"><SectionHeading eyebrow="Projects" title="Add public projects here." /><a class="text-link" href={sitePath('/projects/')}>Explore projects ↗</a></div><div class="template-empty">Project cards will appear here after public entries are added.</div></div>
    </section>
    <section class="section-space section-muted">
      <div class="shell narrow-section"><div class="split-heading"><SectionHeading eyebrow="Recent news" title="Add public updates here." /><a class="text-link" href={sitePath('/news/')}>See all news ↗</a></div><div class="template-empty">News items will appear here after public entries are added.</div></div>
    </section>
    <section class="contact-band">
      <div class="shell contact-band__inner"><div><p class="eyebrow">Contact</p><h2>Add a public contact note.</h2></div><p class="muted">Public contact details can be added here when ready.</p></div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .section-muted { background: color-mix(in srgb, var(--color-surface) 44%, transparent); border-block: 1px solid color-mix(in srgb, var(--color-border) 68%, transparent); }
  .narrow-grid { display: grid; grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 9vw, 8rem); align-items: start; }
  .about-copy { max-width: 62ch; color: var(--color-muted); }
  .about-copy p { margin: 0 0 1.1rem; }
  .split-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.5rem; }
  .split-heading .section-heading { margin-bottom: 0; }
  .text-link { flex: none; color: var(--color-primary); font-size: 0.87rem; font-weight: 700; text-decoration: none; }
  .template-empty { min-height: 8rem; display: grid; place-items: center; padding: 1.5rem; border: 1px dashed var(--color-border-strong); border-radius: 1rem; color: var(--color-muted); text-align: center; }
  .narrow-section { max-width: 900px; }
  .contact-band { border-top: 1px solid var(--color-border); background: var(--color-primary); color: var(--color-primary-contrast); }
  .contact-band__inner { display: flex; justify-content: space-between; gap: 2rem; align-items: center; padding-block: 3.8rem; }
  .contact-band .eyebrow { color: var(--color-accent); }
  .contact-band h2 { max-width: 13ch; margin: 0.6rem 0 0; font-size: clamp(1.9rem, 4vw, 3.4rem); letter-spacing: -0.06em; line-height: 1; }
  .contact-band .muted { max-width: 32ch; color: color-mix(in srgb, var(--color-primary-contrast) 70%, transparent); }
  @media (max-width: 700px) { .narrow-grid, .contact-band__inner { grid-template-columns: 1fr; display: grid; gap: 1.5rem; } .split-heading { align-items: start; display: grid; gap: 1rem; } }
</style>
