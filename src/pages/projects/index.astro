---
import ContentLayout from '../../layouts/ContentLayout.astro';
---
<ContentLayout title="Projects" description="A space for public projects and project descriptions.">
  <div class="project-intro"><p>Add a short public overview of your projects here.</p><p>Project cards and detail pages will appear after public entries are added.</p></div>
  <div class="template-placeholder">No public projects have been added yet.</div>
</ContentLayout>

<style>
  .project-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 3rem; color: var(--color-muted); }
  .project-intro p { margin: 0; }
  .template-placeholder { min-height: 12rem; display: grid; place-items: center; padding: 1.5rem; border: 1px dashed var(--color-border-strong); border-radius: 1rem; color: var(--color-muted); text-align: center; }
  @media (max-width: 700px) { .project-intro { grid-template-columns: 1fr; } }
</style>
